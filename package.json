{
  "name": "fogar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fogar: a private new tab that answers from a model running in your browser, or from a cloud endpoint you bring your own key for.",
  "scripts": {
    "gen:wllama": "node scripts/gen-wllama-workers.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:tesseract": "node scripts/gen-tesseract.mjs",
    "gen": "npm run gen:wllama && npm run gen:tesseract",
    "dev": "npm run gen && wxt",
    "build": "npm run gen && wxt build",
    "zip": "npm run gen && wxt zip",
    "postinstall": "wxt prepare",
    "test:spike": "node scripts/spike-smoke.mjs",
    "shots": "node scripts/screenshot.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@wllama/wllama": "3.6.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.136.1",
    "wxt": "^0.21.4"
  }
}
